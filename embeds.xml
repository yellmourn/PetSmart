<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

<!-- Everything PetSmart loads, in order. Order matters: each file can use
     what the files above it shared through the addon namespace (ns). -->

<!-- Libraries: LibStub first, then CallbackHandler, then everything that needs them. -->
<Script file="Libs\LibStub\LibStub.lua"/>
<Script file="Libs\CallbackHandler-1.0\CallbackHandler-1.0.lua"/>
<Script file="Libs\HereBeDragons\HereBeDragons-2.0.lua"/>
<Script file="Libs\HereBeDragons\HereBeDragons-Pins-2.0.lua"/>
<Script file="Libs\LibDataBroker-1.1\LibDataBroker-1.1.lua"/>
<Script file="Libs\LibDBIcon-1.0\LibDBIcon-1.0.lua"/>

<!-- Which client is this? Must load first: the data files below check it. -->
<Script file="Core\Client.lua"/>

<!-- Static data (pets, abilities, rares, tame areas). Data\Forever runs only on
     WoW: Forever, Data\Classic only on WoW Classic Era, Data\TBC only on WoW: Burning
     Crusade Anniversary (each file checks the client). -->
<Script file="Data\Core.lua"/>
<Script file="Data\Forever\FamilyData.lua"/>
<Script file="Data\Forever\RareSpawnData.lua"/>
